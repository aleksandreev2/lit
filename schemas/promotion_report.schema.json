{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sistema-bogatstva/promotion-report.schema.json",
  "title": "Sistema Bogatstva Promotion Report",
  "type": "object",
  "required": [
    "book_id",
    "chapter",
    "result",
    "freeze_manifest_sha256",
    "chapter_sha256",
    "author_approval_id",
    "chapter_delta_sha256",
    "candidate_hashes",
    "next_chapter"
  ],
  "properties": {
    "book_id": {"const": "SISTEMA_BOGATSTVA"},
    "chapter": {"type": "integer", "minimum": 1},
    "result": {"const": "PROMOTED"},
    "freeze_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "author_approval_id": {"type": "string", "pattern": "^SB-APP-[A-Z0-9][A-Z0-9_-]*$"},
    "chapter_delta_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_hashes": {
      "type": "object",
      "required": ["runtime", "state", "system", "active_arc", "next_manifest"],
      "properties": {
        "runtime": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "state": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "system": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "active_arc": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "next_manifest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "next_chapter": {"type": "integer", "minimum": 2}
  },
  "additionalProperties": false
}
