{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sistema-bogatstva/dependency-graph.schema.json",
  "title": "Sistema Bogatstva Dependency Graph",
  "type": "object",
  "required": ["book_id", "schema_version", "nodes"],
  "properties": {
    "book_id": {"const": "SISTEMA_BOGATSTVA"},
    "schema_version": {"type": "integer", "minimum": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["INPUT", "QA", "EVIDENCE", "FREEZE", "ARTIFACT", "DELIVERABLE"]},
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
