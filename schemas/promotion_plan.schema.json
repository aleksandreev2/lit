{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sistema-bogatstva/promotion-plan.schema.json",
  "title": "Sistema Bogatstva Promotion Plan",
  "type": "object",
  "required": [
    "book_id",
    "chapter",
    "chapter_title",
    "freeze_manifest",
    "author_approval",
    "chapter_delta",
    "candidate_runtime",
    "candidate_state",
    "candidate_system",
    "candidate_active_arc",
    "next_manifest"
  ],
  "properties": {
    "book_id": {"const": "SISTEMA_BOGATSTVA"},
    "chapter": {"type": "integer", "minimum": 1},
    "chapter_title": {"type": "string", "minLength": 1},
    "freeze_manifest": {"type": "string", "minLength": 1},
    "author_approval": {"type": "string", "minLength": 1},
    "chapter_delta": {"type": "string", "minLength": 1},
    "candidate_runtime": {"type": "string", "minLength": 1},
    "candidate_state": {"type": "string", "minLength": 1},
    "candidate_system": {"type": "string", "minLength": 1},
    "candidate_active_arc": {"type": "string", "minLength": 1},
    "next_manifest": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
