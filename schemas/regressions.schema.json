{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sistema-bogatstva/regressions.schema.json",
  "title": "Sistema Bogatstva Regression Lock Register",
  "type": "object",
  "required": ["book_id", "schema_version", "rules"],
  "properties": {
    "book_id": {"const": "SISTEMA_BOGATSTVA"},
    "schema_version": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner_family",
          "severity",
          "name",
          "description",
          "positive_examples",
          "negative_examples",
          "detection_type",
          "fixture_test_path",
          "affected_stages",
          "introduced_by",
          "superseded_by"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^SB-[A-Z]+-[0-9]{3}$"},
          "owner_family": {"type": "string", "minLength": 1},
          "severity": {"enum": ["BLOCK", "REVIEW"]},
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "positive_examples": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "negative_examples": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "detection_type": {"enum": ["DETERMINISTIC", "HEURISTIC", "SEMANTIC"]},
          "fixture_test_path": {"type": ["string", "null"], "minLength": 1},
          "affected_stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "PREWRITE",
                "DRAFT_READY_FOR_EDITOR",
                "QA_IN_PROGRESS",
                "FINAL_CANDIDATE",
                "FINAL_TEXT_FROZEN",
                "AUTHOR_APPROVED",
                "HAPPENED"
              ]
            }
          },
          "introduced_by": {"type": "string", "minLength": 1},
          "superseded_by": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^SB-[A-Z]+-[0-9]{3}$"}
            ]
          },
          "matcher": {
            "type": "object",
            "required": [
              "type",
              "tokens",
              "skip_if_question",
              "confidence",
              "message",
              "suggestions"
            ],
            "properties": {
              "type": {"const": "TOKEN_PATTERN"},
              "tokens": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["any_of"],
                  "properties": {
                    "any_of": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    }
                  },
                  "additionalProperties": false
                }
              },
              "skip_if_question": {"type": "boolean"},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
              "message": {"type": "string", "minLength": 1},
              "suggestions": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "detection_type": {"enum": ["DETERMINISTIC", "HEURISTIC"]}
              }
            },
            "then": {
              "properties": {"fixture_test_path": {"type": "string", "minLength": 1}}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
